# Copy this to .env.local for local development, and set the same
# variables in Vercel: Project Settings -> Environment Variables.

# Added automatically when you connect a Postgres database to this
# project from the Vercel dashboard (Storage tab -> Create Database,
# or Marketplace -> Neon/Supabase). You normally do NOT set this by
# hand -- Vercel injects it once the database is connected.
POSTGRES_URL=

# A private password of your choice, used to view contact-form leads at
# /admin/leads?key=YOUR_KEY. Pick any long random string.
ADMIN_LEADS_KEY=
